DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
APP_URL="https://lms.example.com"
API_CORS_ORIGIN="https://lms.example.com"
AUTH_SECRET="replace-with-at-least-32-random-characters"
SESSION_TTL_SECONDS="28800"
REMEMBERED_SESSION_TTL_SECONDS="2592000"
EMAIL_VERIFICATION_REQUIRED="true"
EMAIL_VERIFICATION_TTL_SECONDS="86400"
PASSWORD_RESET_TTL_SECONDS="1800"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="smtp-user"
SMTP_PASSWORD="smtp-password"
SMTP_FROM="LMS <no-reply@example.com>"
INITIAL_ADMIN_NAME="LMS Administrator"
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="replace-with-a-strong-initial-password"
SEED_DEMO_DATA="false"
